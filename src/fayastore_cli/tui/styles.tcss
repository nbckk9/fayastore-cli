/* Fayastore TUI - Firefoo-inspired Design */
/* Based on Textual's dark theme with custom enhancements */

Screen {
    background: $surface;
}

/* Header - Clean, minimal design */
Header {
    dock: top;
    height: 2;
    background: $surface-lighten-1;
    border-bottom: solid $accent;
}

/* Footer - Compact with key hints */
Footer {
    dock: bottom;
    height: 1;
    background: $surface-darken-2;
    color: $text-muted;
}

/* Main browser layout */
#browser-container {
    layout: horizontal;
    height: 100%;
}

/* Collections panel - Left sidebar */
#collections-panel {
    width: 28%;
    min-width: 22;
    max-width: 35;
    border: solid $accent;
    border-right: solid $surface-lighten-2;
    border-top: none;
    border-bottom: none;
    border-left: none;
    background: $surface-darken-1;
}

/* Documents panel - Main content */
#documents-panel {
    width: 72%;
    border: solid $surface-lighten-2;
    background: $surface;
}

/* Panel headers */
.panel-header {
    dock: top;
    height: 2;
    padding: 0 1;
    background: $surface-lighten-1;
    text-style: bold;
    content-align: left middle;
    color: $text;
}

/* Collection tree */
#collection-tree {
    height: 100%;
    scrollbar-gutter: stable;
}

#collection-tree > .tree--guides {
    color: $surface-lighten-3;
}

#collection-tree > .tree--cursor {
    background: $accent;
    color: $text;
    text-style: bold;
}

#collection-tree > .tree--highlight {
    background: $accent-darken-1;
}

/* Document table */
#document-table {
    height: 100%;
}

#document-table > .datatable--header {
    background: $surface-lighten-1;
    text-style: bold;
    color: $text;
}

#document-table > .datatable--cursor {
    background: $accent;
    color: $text;
}

#document-table > .datatable--row-hover {
    background: $accent-darken-2;
}

/* Status bar */
#status-bar {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: $surface-darken-2;
    color: $text-muted;
    text-style: italic;
}

/* Viewer screen */
#viewer-container {
    padding: 1;
    height: 100%;
}

#document-path {
    height: 2;
    padding: 0 1;
    background: $surface-lighten-1;
    text-style: bold;
    border-bottom: solid $accent;
    content-align: left middle;
}

#document-content {
    height: 1fr;
    padding: 1;
    background: $surface-darken-1;
    border: solid $surface-lighten-2;
    margin: 1 0;
}

/* Editor screen */
#editor-container {
    padding: 1;
    height: 100%;
}

#editor-header {
    height: 2;
    padding: 0 1;
    background: $surface-lighten-1;
    text-style: bold;
    border-bottom: solid $accent;
}

#json-editor {
    height: 100%;
    border: solid $surface-lighten-2;
}

#editor-buttons {
    dock: bottom;
    height: 3;
    padding: 1;
    align: center middle;
}

#editor-buttons Button {
    margin: 0 1;
    min-width: 12;
}

/* Query screen */
#query-container {
    padding: 1;
    height: 100%;
}

#query-inputs {
    height: auto;
    padding: 1;
    border: solid $accent;
    background: $surface-darken-1;
    margin-bottom: 1;
}

.input-row {
    height: 3;
    margin-bottom: 1;
}

.input-label {
    width: 10;
    height: 3;
    content-align: left middle;
    padding: 0 1;
    text-style: bold;
    color: $text;
}

.input-row Input {
    width: 1fr;
    height: 3;
    border: solid $surface-lighten-2;
}

.button-row {
    height: 3;
    margin-top: 1;
}

.button-row Button {
    margin-right: 1;
}

#results-table {
    height: 1fr;
    border: solid $surface-lighten-2;
}

#query-status {
    height: 1;
    padding: 0 1;
    background: $surface-darken-2;
    color: $text-muted;
}

/* Help screen */
#help-container {
    padding: 2;
    align: center middle;
}

#help-content {
    width: 55;
    height: auto;
    max-height: 80;
    padding: 2;
    border: solid $accent;
    background: $surface;
    overflow-y: auto;
}

#help-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    padding-bottom: 1;
    border-bottom: solid $surface-lighten-2;
    margin-bottom: 1;
}

.help-section {
    margin-top: 1;
}

.help-section-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 0;
}

.help-key {
    background: $surface-lighten-1;
    padding: 0 2;
    margin-right: 0;
    min-width: 8;
    text-align: center;
}

.help-action {
    margin-left: 1;
}

/* Confirmation dialog */
#confirm-dialog {
    align: center middle;
}

#confirm-content {
    width: 50;
    height: auto;
    padding: 2;
    border: solid $warning;
    background: $surface;
}

#confirm-buttons {
    margin-top: 2;
    align: center middle;
}

#confirm-buttons Button {
    margin: 0 1;
}

/* Loading indicator */
#loading-text {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-style: italic;
    color: $text-muted;
}

/* Error message */
.error-message {
    color: $error;
    padding: 1;
    text-style: bold;
}

/* Success message */
.success-message {
    color: $success;
    padding: 1;
}

/* Empty state */
.empty-state {
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: $text-muted;
    text-style: italic;
}

/* Button variants */
Button {
    border: none;
}

Button:focus {
    outline: solid $accent;
}

/* Input focus state */
Input:focus, TextArea:focus {
    border: solid $accent;
}

/* Toast notifications */
Toast {
    background: $surface-lighten-1;
    border: solid $accent;
}
